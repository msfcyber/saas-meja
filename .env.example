APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

OBSERVABILITY_SLOW_REQUEST_MS=1000
OBSERVABILITY_QUEUE_DEPTH_THRESHOLD=100
OBSERVABILITY_QUEUE_MONITOR_ENABLED=true
OBSERVABILITY_FAILED_JOBS_THRESHOLD=0
OBSERVABILITY_STALE_PAYMENT_EVENT_MINUTES=15

OPS_BACKUP_ENABLED=false
OPS_BACKUP_DESTINATION=storage/backups
OPS_BACKUP_RETENTION_DAYS=30
OPS_BACKUP_RESTORE_DRILL_ENABLED=false

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

REVERB_APP_ID=local
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_TOLERANCE=300
PAYMENT_DEFAULT_PROVIDER=midtrans
# Platform Midtrans key used only for SaaS subscription invoices/webhooks.
# Tenant order credentials are encrypted and managed in Settings > Gateway.
MIDTRANS_SERVER_KEY=
MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/v1/transactions
MIDTRANS_STATUS_URL=https://api.sandbox.midtrans.com/v2
SUBSCRIPTION_TRIAL_DAYS=14
SUBSCRIPTION_DEFAULT_PLAN=tumbuh
