APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

OBSERVABILITY_SLOW_REQUEST_MS=1000
OBSERVABILITY_QUEUE_DEPTH_THRESHOLD=100
OBSERVABILITY_QUEUE_MONITOR_ENABLED=true
OBSERVABILITY_FAILED_JOBS_THRESHOLD=0
OBSERVABILITY_STALE_PAYMENT_EVENT_MINUTES=15
OBSERVABILITY_PENDING_REFUNDS_THRESHOLD=0
OBSERVABILITY_PENDING_INVOICES_THRESHOLD=100

OPS_BACKUP_ENABLED=false
OPS_BACKUP_DESTINATION=storage/backups
OPS_BACKUP_RETENTION_DAYS=30
OPS_BACKUP_RESTORE_DRILL_ENABLED=false
OPS_BACKUP_REMOTE_ENABLED=false
OPS_BACKUP_REMOTE_DISK=s3-backup
OPS_BACKUP_REMOTE_PREFIX=meja
OPS_BACKUP_MYSQL_CREDENTIALS_FILE=/run/secrets/meja-mysql.cnf
OPS_BACKUP_MYSQL_DUMP_BINARY=mysqldump
OPS_BACKUP_MYSQL_DUMP_TIMEOUT=900
OPS_BACKUP_MYSQL_RESTORE_ENABLED=false
OPS_BACKUP_MYSQL_RESTORE_CREDENTIALS_FILE=/run/secrets/meja-mysql-restore.cnf
OPS_BACKUP_MYSQL_RESTORE_BINARY=mysql
OPS_BACKUP_MYSQL_RESTORE_HOST=127.0.0.1
OPS_BACKUP_MYSQL_RESTORE_PORT=3306
OPS_BACKUP_MYSQL_RESTORE_DATABASE=meja_restore
OPS_BACKUP_MYSQL_RESTORE_TIMEOUT=900

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
FILESYSTEM_PUBLIC_DRIVER=local
FILESYSTEM_PUBLIC_ROOT=
FILESYSTEM_PUBLIC_URL="${APP_URL}/storage"
FILESYSTEM_PUBLIC_BUCKET=
FILESYSTEM_PUBLIC_ACCESS_KEY_ID=
FILESYSTEM_PUBLIC_SECRET_ACCESS_KEY=
FILESYSTEM_PUBLIC_DEFAULT_REGION=us-east-1
FILESYSTEM_PUBLIC_ENDPOINT=
FILESYSTEM_PUBLIC_USE_PATH_STYLE_ENDPOINT=false
QUEUE_CONNECTION=database

REVERB_APP_ID=local
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_INTERNAL_HOST=reverb
REVERB_EXTERNAL_PORT=8081

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Required when running the platform/demo seeders; never use shared production credentials.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
DEMO_OWNER_EMAIL=
DEMO_OWNER_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_BACKUP_BUCKET=
AWS_BACKUP_ACCESS_KEY_ID=
AWS_BACKUP_SECRET_ACCESS_KEY=
AWS_BACKUP_DEFAULT_REGION=us-east-1
AWS_BACKUP_ENDPOINT=
AWS_BACKUP_USE_PATH_STYLE_ENDPOINT=false
AWS_BACKUP_SERVER_SIDE_ENCRYPTION=AES256
AWS_BACKUP_SSE_KMS_KEY_ID=

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_TOLERANCE=300
PAYMENT_DEFAULT_PROVIDER=midtrans
# Platform Midtrans key used only for SaaS subscription invoices/webhooks.
# Tenant order credentials are encrypted and managed in Settings > Gateway.
MIDTRANS_SERVER_KEY=
MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/v1/transactions
MIDTRANS_STATUS_URL=https://api.sandbox.midtrans.com/v2
MIDTRANS_REFUND_URL=https://api.sandbox.midtrans.com/v2
SUBSCRIPTION_TRIAL_DAYS=14
SUBSCRIPTION_DEFAULT_PLAN=tumbuh

# Production Compose requires HTTPS, S3-compatible public storage, and an alert destination.
# HTTPS_PORT=443
# TLS_CERTS_PATH=/absolute/path/to/certificates
# FILESYSTEM_PUBLIC_DRIVER=s3
# FILESYSTEM_PUBLIC_BUCKET=meja-assets
# FILESYSTEM_PUBLIC_ACCESS_KEY_ID=
# FILESYSTEM_PUBLIC_SECRET_ACCESS_KEY=
# FILESYSTEM_PUBLIC_ENDPOINT=https://s3.example.com
# FILESYSTEM_PUBLIC_URL=https://assets.example.com
# REVERB_HOST=app.example.com
# REVERB_EXTERNAL_PORT=443
# REVERB_SCHEME=https
# OPS_ALERT_WEBHOOK_URL=https://alerts.example.com/meja
